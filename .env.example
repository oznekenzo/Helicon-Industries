# Supabase transaction pooler used by the running application.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Direct Supabase connection used only for local migrations.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/postgres

# HTTP Basic Auth required for every application route.
BASIC_AUTH_USERNAME=helicon
BASIC_AUTH_PASSWORD=replace-with-a-strong-password
